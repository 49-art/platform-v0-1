{
  "name": "platform-v0-1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @platform/web dev",
    "dev:admin": "pnpm --filter @platform/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @platform/core db:generate",
    "db:migrate:local": "pnpm --filter @platform/web db:migrate:local",
    "seed": "pnpm --filter @platform/web seed"
  }
}
